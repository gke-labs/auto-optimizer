set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Pinned versions and commit SHAs for upstream dependencies.
# To bump:
# - AGENT_SANDBOX_VERSION: Check latest release at https://github.com/kubernetes-sigs/agent-sandbox/releases
# - SERVICE_PORTALS_COMMIT: Check latest commit at https://github.com/gke-labs/service-portals/commits/main
# - IN_CLUSTER_STORAGE_COMMIT: Check latest commit at https://github.com/gke-labs/in-cluster-storage/commits/main
AGENT_SANDBOX_VERSION="v1.0.8"
SERVICE_PORTALS_COMMIT="686b34d8aa74546af1039119bbfa6e05ead15f53"
IN_CLUSTER_STORAGE_COMMIT="923578df519c02cd0da1b7455d8a1e0278a103c4"

# Use tools from .build/bin if present
if [[ -d "${REPO_ROOT}/.build/bin" ]]; then
  export PATH="${REPO_ROOT}/.build/bin:${PATH}"
fi

CURRENT_CONTEXT="$(kubectl config current-context 2>/dev/null || echo "unknown")"
echo "=== Deploying auto-optimizer dependencies to kubeconfig context: ${CURRENT_CONTEXT} ==="

IS_KIND="false"
KIND_CLUSTER_NAME="auto-optimizer"
if [[ "${CURRENT_CONTEXT}" == kind-* ]]; then
  IS_KIND="true"
  KIND_CLUSTER_NAME="${CURRENT_CONTEXT#kind-}"
fi

ensure_docker_cli() {
  if ! command -v docker >/dev/null 2>&1; then
    local docker_version="29.2.1"
    local docker_bin="${REPO_ROOT}/.build/src/docker/${docker_version}/bin/docker"
    if [[ ! -x "${docker_bin}" ]]; then
      echo "Installing docker ${docker_version}..." >&2
      mkdir -p "$(dirname "${docker_bin}")"
      curl -sLo "${REPO_ROOT}/.build/src/docker/${docker_version}/docker.tgz" "https://download.docker.com/linux/static/stable/x86_64/docker-${docker_version}.tgz"
      tar -C "$(dirname "${docker_bin}")" -xzf "${REPO_ROOT}/.build/src/docker/${docker_version}/docker.tgz" --strip-components=1 docker/docker
      rm "${REPO_ROOT}/.build/src/docker/${docker_version}/docker.tgz"
      chmod +x "${docker_bin}"
    fi
    mkdir -p "${REPO_ROOT}/.build/bin"
    ln -sf "../src/docker/${docker_version}/bin/docker" "${REPO_ROOT}/.build/bin/docker"
    export PATH="${REPO_ROOT}/.build/bin:${PATH}"
  fi
}

ensure_docker_cli

# Note: ap builds container images by invoking 'docker buildx build' under the hood
# (see gke-labs-infra/ap/pkg/images/build.go). When running in minimal environments
# (such as container agents with a remote DOCKER_HOST daemon), the docker CLI and
# docker-buildx plugin must be available on PATH / in cli-plugins.
ensure_docker_buildx() {
  if ! docker buildx version >/dev/null 2>&1; then
    local buildx_version="v0.21.1"
    local os="$(go env GOOS)"
    local arch="$(go env GOARCH)"
    local buildx_bin="${REPO_ROOT}/.build/src/docker-buildx/${buildx_version}/bin/docker-buildx"
    if [[ ! -x "${buildx_bin}" ]]; then
      echo "Installing docker-buildx ${buildx_version} for ${os}/${arch}..." >&2
      mkdir -p "$(dirname "${buildx_bin}")"
      curl -sLo "${buildx_bin}" "https://github.com/docker/buildx/releases/download/${buildx_version}/buildx-${buildx_version}.${os}-${arch}"
      chmod +x "${buildx_bin}"
    fi
    mkdir -p "${REPO_ROOT}/.build/bin" "${HOME}/.docker/cli-plugins"
    ln -sf "../src/docker-buildx/${buildx_version}/bin/docker-buildx" "${REPO_ROOT}/.build/bin/docker-buildx"
    ln -sf "${REPO_ROOT}/.build/bin/docker-buildx" "${HOME}/.docker/cli-plugins/docker-buildx"
  fi
}

if command -v docker >/dev/null 2>&1; then
  ensure_docker_buildx
fi

# Handle IMAGE_PREFIX and IMAGE_TAG.
# On kind, default IMAGE_PREFIX to auto-optimizer.local and IMAGE_TAG to dev.
# Using a non-'latest' tag (e.g. 'dev') ensures Kubernetes defaults imagePullPolicy
# to IfNotPresent, allowing kind to run images loaded directly into the node.
# On a real cluster, the caller must specify IMAGE_PREFIX (e.g. Artifact Registry),
# and IMAGE_TAG defaults to latest.
if [[ "${IS_KIND}" == "true" ]]; then
  export IMAGE_PREFIX="${IMAGE_PREFIX:-auto-optimizer.local}"
  export IMAGE_TAG="${IMAGE_TAG:-dev}"
else
  if [[ -z "${IMAGE_PREFIX:-}" ]]; then
    echo "ERROR: IMAGE_PREFIX must be set when deploying to a non-kind cluster (e.g. IMAGE_PREFIX=gcr.io/my-project)" >&2
    exit 1
  fi
  export IMAGE_TAG="${IMAGE_TAG:-latest}"
fi

# Cache directory for sibling repositories outside the source tree
CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/auto-optimizer"

ensure_cached_repo() {
  local repo_name="$1"
  local repo_url="$2"
  local commit="$3"
  local target_dir="${CACHE_DIR}/${repo_name}/${commit}"

  if [[ -d "${target_dir}/.git" ]]; then
    local current_commit
    current_commit="$(git -C "${target_dir}" rev-parse HEAD 2>/dev/null || true)"
    if [[ "${current_commit}" == "${commit}"* ]]; then
      echo "${target_dir}"
      return 0
    fi
  fi

  echo "Cloning ${repo_name} at commit ${commit}..." >&2
  mkdir -p "${target_dir}"
  if [[ ! -d "${target_dir}/.git" ]]; then
    git clone "${repo_url}" "${target_dir}" >&2
  fi
  git -C "${target_dir}" fetch origin >&2
  git -C "${target_dir}" checkout "${commit}" >&2

  echo "${target_dir}"
}

# ------------------------------------------------------------------------------
# 1. Namespaces
# ------------------------------------------------------------------------------
echo "--- Ensuring namespaces ao-system and ao-sandboxes exist ---"
kubectl create namespace ao-system --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace ao-sandboxes --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 2. agent-sandbox
# ------------------------------------------------------------------------------
echo "--- Installing agent-sandbox (${AGENT_SANDBOX_VERSION}) ---"
kubectl apply --server-side -f "https://github.com/kubernetes-sigs/agent-sandbox/releases/download/${AGENT_SANDBOX_VERSION}/sandbox.yaml"
kubectl apply --server-side -f "https://github.com/kubernetes-sigs/agent-sandbox/releases/download/${AGENT_SANDBOX_VERSION}/extensions.yaml"

echo "Waiting for sandboxes.agents.x-k8s.io CRD to be established..."
kubectl wait --for=condition=Established crd/sandboxes.agents.x-k8s.io --timeout=60s

echo "Waiting for agent-sandbox-controller deployment in agent-sandbox-system..."
kubectl rollout status deployment/agent-sandbox-controller -n agent-sandbox-system --timeout=120s

# ------------------------------------------------------------------------------
# 3. service-portals
# ------------------------------------------------------------------------------
echo "--- Building service-portals images (${SERVICE_PORTALS_COMMIT}) with ap build ---"
# Sandboxes use service-portals exclusively in transparent sidecar mode (see docs/design.md).
# We do not deploy the central explicit proxy (k8s/manifests.yaml) or require cert-manager.
# We build the container images (init-service-portals, all-in-one-portal, gitproxy-server, service-portal)
# using 'ap build'.
SERVICE_PORTALS_DIR="$(ensure_cached_repo "service-portals" "https://github.com/gke-labs/service-portals.git" "${SERVICE_PORTALS_COMMIT}")"

if [[ "${IS_KIND}" == "true" ]]; then
  echo "Building service-portals images locally..."
  (cd "${SERVICE_PORTALS_DIR}" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest build)
  echo "Loading service-portals images into kind cluster ${KIND_CLUSTER_NAME}..."
  kind load docker-image \
    "${IMAGE_PREFIX}/init-service-portals:${IMAGE_TAG}" \
    "${IMAGE_PREFIX}/all-in-one-portal:${IMAGE_TAG}" \
    "${IMAGE_PREFIX}/gitproxy-server:${IMAGE_TAG}" \
    "${IMAGE_PREFIX}/service-portal:${IMAGE_TAG}" \
    --name "${KIND_CLUSTER_NAME}"
else
  echo "Building and pushing service-portals images to ${IMAGE_PREFIX}..."
  (cd "${SERVICE_PORTALS_DIR}" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest build --push)
fi

# ------------------------------------------------------------------------------
# 4. in-cluster-storage (ObjectFS)
# ------------------------------------------------------------------------------
echo "--- Installing in-cluster-storage / ObjectFS (${IN_CLUSTER_STORAGE_COMMIT}) with ap ---"
kubectl create namespace kube-objectfs-system --dry-run=client -o yaml | kubectl apply -f -

IN_CLUSTER_STORAGE_DIR="$(ensure_cached_repo "in-cluster-storage" "https://github.com/gke-labs/in-cluster-storage.git" "${IN_CLUSTER_STORAGE_COMMIT}")"

BACKEND_URL="${OBJECTFS_BACKEND:-}"
USE_FAKES3="false"
if [[ -z "${BACKEND_URL}" ]]; then
  USE_FAKES3="true"
  BACKEND_URL="s3://objectfs-bucket?endpoint=http://fakes3.kube-objectfs-system.svc.cluster.local:9000&region=us-east-1&s3ForcePathStyle=true"
fi

if [[ "${IS_KIND}" == "true" ]]; then
  if [[ "${USE_FAKES3}" == "true" ]]; then
    echo "Building and loading fakes3 for kind..."
    (cd "${IN_CLUSTER_STORAGE_DIR}/fakes3" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest build)
    kind load docker-image "${IMAGE_PREFIX}/fakes3:${IMAGE_TAG}" --name "${KIND_CLUSTER_NAME}"

    echo "Deploying in-cluster fakes3 service and deployment..."
    cat << EOF | kubectl apply -f -
apiVersion: v1
kind: Service
metadata:
  name: fakes3
  namespace: kube-objectfs-system
spec:
  ports:
    - port: 9000
      targetPort: 9000
  selector:
    app: fakes3
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fakes3
  namespace: kube-objectfs-system
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fakes3
  template:
    metadata:
      labels:
        app: fakes3
    spec:
      containers:
        - name: fakes3
          image: ${IMAGE_PREFIX}/fakes3:${IMAGE_TAG}
          imagePullPolicy: IfNotPresent
          args: ["--listen=0.0.0.0:9000", "--buckets=objectfs-bucket", "--quiet"]
          ports:
            - containerPort: 9000
EOF
    echo "Waiting for fakes3 deployment..."
    kubectl rollout status deployment/fakes3 -n kube-objectfs-system --timeout=60s
  fi

  echo "Building in-cluster-storage images..."
  (cd "${IN_CLUSTER_STORAGE_DIR}" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest build)
  echo "Loading in-cluster-storage images into kind cluster ${KIND_CLUSTER_NAME}..."
  kind load docker-image \
    "${IMAGE_PREFIX}/wal-buffer:${IMAGE_TAG}" \
    "${IMAGE_PREFIX}/objectfs-controller:${IMAGE_TAG}" \
    "${IMAGE_PREFIX}/objectfs-node-daemon:${IMAGE_TAG}" \
    --name "${KIND_CLUSTER_NAME}"

  echo "Deploying in-cluster-storage manifests with ap deploy..."
  (cd "${IN_CLUSTER_STORAGE_DIR}" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest deploy --skip-push)
else
  echo "Deploying in-cluster-storage with ap deploy (pushing to ${IMAGE_PREFIX})..."
  (cd "${IN_CLUSTER_STORAGE_DIR}" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest deploy)
fi

# Configure backend via objectfs-config ConfigMap (replaces backend without patching manifests)
echo "Applying objectfs-config ConfigMap (backend: ${BACKEND_URL})..."
cat << EOF | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: objectfs-config
  namespace: kube-objectfs-system
data:
  backend: "${BACKEND_URL}"
EOF

# If using fakes3, create credentials secret and inject into StatefulSets via kubectl set env
if [[ "${USE_FAKES3}" == "true" ]]; then
  echo "Configuring fakes3 credentials secret..."
  kubectl create secret generic objectfs-s3-credentials \
    -n kube-objectfs-system \
    --from-literal=AWS_ACCESS_KEY_ID=fakes3 \
    --from-literal=AWS_SECRET_ACCESS_KEY=fakes3 \
    --from-literal=AWS_REGION=us-east-1 \
    --dry-run=client -o yaml | kubectl apply -f -

  kubectl set env statefulset/wal-buffer -n kube-objectfs-system --from=secret/objectfs-s3-credentials
  kubectl set env statefulset/objectfs-controller -n kube-objectfs-system --from=secret/objectfs-s3-credentials

  # If pods were started before credentials were set, reset any crashed pod so it restarts immediately
  WAL_READY="$(kubectl get pod wal-buffer-0 -n kube-objectfs-system -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "False")"
  if [[ "${WAL_READY}" != "True" ]]; then
    kubectl delete pod wal-buffer-0 -n kube-objectfs-system --ignore-not-found >/dev/null 2>&1 || true
  fi
  CTRL_READY="$(kubectl get pod objectfs-controller-0 -n kube-objectfs-system -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "False")"
  if [[ "${CTRL_READY}" != "True" ]]; then
    kubectl delete pod objectfs-controller-0 -n kube-objectfs-system --ignore-not-found >/dev/null 2>&1 || true
  fi
fi

echo "Waiting for wal-buffer statefulset in kube-objectfs-system..."
kubectl rollout status statefulset/wal-buffer -n kube-objectfs-system --timeout=120s

echo "Waiting for objectfs-controller statefulset in kube-objectfs-system..."
kubectl rollout status statefulset/objectfs-controller -n kube-objectfs-system --timeout=120s

echo "Waiting for objectfs-node-daemon daemonset in kube-objectfs-system..."
kubectl rollout status daemonset/objectfs-node-daemon -n kube-objectfs-system --timeout=120s

echo "Waiting for StorageClass objectfs-exclusive-local to exist..."
SC_FOUND="false"
for _ in $(seq 1 30); do
  if kubectl get storageclass objectfs-exclusive-local >/dev/null 2>&1; then
    SC_FOUND="true"
    break
  fi
  sleep 2
done

if [[ "${SC_FOUND}" != "true" ]]; then
  echo "ERROR: StorageClass objectfs-exclusive-local was not found after waiting." >&2
  exit 1
fi

# ------------------------------------------------------------------------------
# 5. auto-optimizer (ao)
# ------------------------------------------------------------------------------
echo "--- Deploying auto-optimizer with ap ---"

if [[ "${IS_KIND}" == "true" ]]; then
  echo "Building auto-optimizer images..."
  (cd "${REPO_ROOT}" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest build)
  echo "Loading auto-optimizer images into kind cluster ${KIND_CLUSTER_NAME}..."
  kind load docker-image \
    "${IMAGE_PREFIX}/geminicli-toolbox:${IMAGE_TAG}" \
    "${IMAGE_PREFIX}/ao:${IMAGE_TAG}" \
    --name "${KIND_CLUSTER_NAME}"

  echo "Deploying auto-optimizer manifests with ap deploy..."
  (cd "${REPO_ROOT}" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest deploy --skip-push)

  OPENAI_MODEL="${OPENAI_MODEL:-fake-eliza}"
  SANDBOX_IMAGE="${SANDBOX_IMAGE:-${IMAGE_PREFIX}/geminicli-toolbox:${IMAGE_TAG}}"

  echo "Configuring ao-config ConfigMap (OPENAI_MODEL=${OPENAI_MODEL}, SANDBOX_IMAGE=${SANDBOX_IMAGE})..."
  cat << EOF | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: ao-config
  namespace: ao-system
data:
  AO_LISTEN: "0.0.0.0:8081"
  SANDBOX_NAMESPACE: "ao-sandboxes"
  OPENAI_MODEL: "${OPENAI_MODEL}"
  SANDBOX_IMAGE: "${SANDBOX_IMAGE}"
EOF

  kubectl rollout restart deployment/ao -n ao-system
else
  echo "Deploying auto-optimizer with ap deploy (pushing to ${IMAGE_PREFIX})..."
  (cd "${REPO_ROOT}" && GOTOOLCHAIN=auto go run github.com/gke-labs/gke-labs-infra/ap@latest deploy)

  if [[ -n "${OPENAI_MODEL:-}" || -n "${SANDBOX_IMAGE:-}" ]]; then
    echo "Configuring ao-config ConfigMap (OPENAI_MODEL=${OPENAI_MODEL:-}, SANDBOX_IMAGE=${SANDBOX_IMAGE:-})..."
    cat << EOF | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: ao-config
  namespace: ao-system
data:
  AO_LISTEN: "0.0.0.0:8081"
  SANDBOX_NAMESPACE: "ao-sandboxes"
  OPENAI_MODEL: "${OPENAI_MODEL:-}"
  SANDBOX_IMAGE: "${SANDBOX_IMAGE:-}"
EOF
    kubectl rollout restart deployment/ao -n ao-system
  fi
fi

echo "Waiting for ao deployment in ao-system..."
kubectl rollout status deployment/ao -n ao-system --timeout=120s

echo "=== deploy-to-kube completed successfully ==="
