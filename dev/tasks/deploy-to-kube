set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Pinned versions and commit SHAs for upstream dependencies.
# To bump:
# - AGENT_SANDBOX_VERSION: Check latest release at https://github.com/kubernetes-sigs/agent-sandbox/releases
# - SERVICE_PORTALS_COMMIT: Check latest commit at https://github.com/gke-labs/service-portals/commits/main
# - IN_CLUSTER_STORAGE_COMMIT: Check latest commit at https://github.com/gke-labs/in-cluster-storage/commits/main
AGENT_SANDBOX_VERSION="v1.0.8"
SERVICE_PORTALS_COMMIT="f34dec9ccc7282c0821129bb515a39a28de77c0f"
IN_CLUSTER_STORAGE_COMMIT="8ece1bbfdefb4afaceac89dec3eaa112428917a9"

GOBIN="${REPO_ROOT}/.build/bin" GOTOOLCHAIN=auto go install github.com/gke-labs/gke-labs-infra/ap@latest
"${REPO_ROOT}/.build/bin/ap" tool install "${REPO_ROOT}/.build/bin"
export PATH="${REPO_ROOT}/.build/bin:${PATH}"

CURRENT_CONTEXT="$(kubectl config current-context 2>/dev/null || echo "unknown")"

IS_KIND="false"
KIND_CLUSTER_NAME="auto-optimizer"
if [[ "${CURRENT_CONTEXT}" == kind-* ]]; then
  IS_KIND="true"
  KIND_CLUSTER_NAME="${CURRENT_CONTEXT#kind-}"
fi

# Parse command-line arguments
CLI_COMPONENTS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --only)
      if [[ $# -lt 2 ]]; then
        echo "ERROR: --only requires a component argument" >&2
        exit 1
      fi
      if [[ -z "${CLI_COMPONENTS}" ]]; then
        CLI_COMPONENTS="$2"
      else
        CLI_COMPONENTS="${CLI_COMPONENTS},$2"
      fi
      shift 2
      ;;
    --only=*)
      val="${1#*=}"
      if [[ -z "${CLI_COMPONENTS}" ]]; then
        CLI_COMPONENTS="${val}"
      else
        CLI_COMPONENTS="${CLI_COMPONENTS},${val}"
      fi
      shift
      ;;
    -h|--help)
      echo "Usage: $0 [--only <component>]"
      echo ""
      echo "Deploy auto-optimizer and its dependencies to a Kubernetes cluster."
      echo ""
      echo "Options:"
      echo "  --only <component>  Deploy only the specified component(s) (comma-separated)."
      echo "                      Available components: agent-sandbox, service-portals, objectfs, ao"
      echo "                      Can be passed multiple times or specified via COMPONENTS env var."
      echo "  -h, --help          Show this help text"
      exit 0
      ;;
    *)
      echo "ERROR: Unknown argument: $1" >&2
      echo "Usage: $0 [--only <component>]" >&2
      exit 1
      ;;
  esac
done

if [[ -n "${CLI_COMPONENTS}" ]]; then
  COMPONENTS="${CLI_COMPONENTS}"
fi

if [[ -z "${COMPONENTS:-}" ]]; then
  if [[ "${IS_KIND}" == "true" ]]; then
    COMPONENTS="agent-sandbox,service-portals,objectfs,ao"
  else
    COMPONENTS="ao"
  fi
fi

# Normalize and validate COMPONENTS
VALID_COMPONENTS="agent-sandbox service-portals objectfs ao"
CLEAN_COMPONENTS=""
IFS=',' read -ra RAW_COMPONENTS <<< "${COMPONENTS}"
for comp in "${RAW_COMPONENTS[@]}"; do
  comp="$(echo "${comp}" | tr -d '[:space:]')"
  if [[ -z "${comp}" ]]; then
    continue
  fi
  is_valid="false"
  for valid in ${VALID_COMPONENTS}; do
    if [[ "${comp}" == "${valid}" ]]; then
      is_valid="true"
      break
    fi
  done
  if [[ "${is_valid}" != "true" ]]; then
    echo "ERROR: Unknown component '${comp}'. Valid components are: agent-sandbox, service-portals, objectfs, ao" >&2
    exit 1
  fi
  # Avoid duplicate entries
  is_duplicate="false"
  for existing in ${CLEAN_COMPONENTS//,/ }; do
    if [[ "${existing}" == "${comp}" ]]; then
      is_duplicate="true"
      break
    fi
  done
  if [[ "${is_duplicate}" == "true" ]]; then
    continue
  fi
  if [[ -z "${CLEAN_COMPONENTS}" ]]; then
    CLEAN_COMPONENTS="${comp}"
  else
    CLEAN_COMPONENTS="${CLEAN_COMPONENTS},${comp}"
  fi
done
COMPONENTS="${CLEAN_COMPONENTS}"

has_component() {
  local target="$1"
  local IFS=','
  for comp in ${COMPONENTS}; do
    if [[ "${comp}" == "${target}" ]]; then
      return 0
    fi
  done
  return 1
}

echo "=== Deploying auto-optimizer dependencies to kubeconfig context: ${CURRENT_CONTEXT} ==="
echo "Components: ${COMPONENTS}"

# Handle IMAGE_PREFIX and IMAGE_TAG.
# On kind, default IMAGE_PREFIX to auto-optimizer.local and IMAGE_TAG to dev.
# Using a non-'latest' tag (e.g. 'dev') ensures Kubernetes defaults imagePullPolicy
# to IfNotPresent, allowing kind to run images loaded directly into the node.
# On a real cluster, the caller must specify IMAGE_PREFIX (e.g. Artifact Registry),
# and IMAGE_TAG defaults to latest.
if [[ "${IS_KIND}" == "true" ]]; then
  export IMAGE_PREFIX="${IMAGE_PREFIX:-auto-optimizer.local}"
  export IMAGE_TAG="${IMAGE_TAG:-dev}"
else
  if [[ -z "${IMAGE_PREFIX:-}" ]]; then
    if has_component "ao" || has_component "service-portals"; then
      echo "ERROR: IMAGE_PREFIX must be set when deploying to a non-kind cluster (e.g. IMAGE_PREFIX=gcr.io/my-project)" >&2
      exit 1
    elif has_component "objectfs" && [[ -n "${OBJECTFS_BACKEND:-}" ]]; then
      echo "ERROR: IMAGE_PREFIX must be set when deploying to a non-kind cluster (e.g. IMAGE_PREFIX=gcr.io/my-project)" >&2
      exit 1
    fi
  fi
  export IMAGE_TAG="${IMAGE_TAG:-latest}"
fi

export SANDBOXD_IMAGE="${IMAGE_PREFIX}/sandboxd:${IMAGE_TAG}"

# Cache directory for sibling repositories outside the source tree
CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/auto-optimizer"

ensure_cached_repo() {
  local repo_name="$1"
  local repo_url="$2"
  local commit="$3"
  local target_dir="${CACHE_DIR}/${repo_name}/${commit}"

  if [[ -d "${target_dir}/.git" ]]; then
    local current_url
    current_url="$(git -C "${target_dir}" remote get-url origin 2>/dev/null || true)"
    if [[ -n "${current_url}" && "${current_url}" != "${repo_url}" ]]; then
      git -C "${target_dir}" remote set-url origin "${repo_url}" >&2
    fi
    local current_commit
    current_commit="$(git -C "${target_dir}" rev-parse HEAD 2>/dev/null || true)"
    if [[ "${current_commit}" == "${commit}"* ]]; then
      echo "${target_dir}"
      return 0
    fi
  fi

  echo "Cloning ${repo_name} at ref ${commit}..." >&2
  mkdir -p "${target_dir}"
  if [[ ! -d "${target_dir}/.git" ]]; then
    git clone "${repo_url}" "${target_dir}" >&2
  fi
  git -C "${target_dir}" fetch origin >&2
  git -C "${target_dir}" checkout "${commit}" >&2
  if git -C "${target_dir}" show-ref --verify --quiet "refs/remotes/origin/${commit}"; then
    git -C "${target_dir}" reset --hard "origin/${commit}" >&2
  fi

  echo "${target_dir}"
}

# Parallel kind image build helpers (bash 3.2 compatible).
KIND_BUILD_LOG_DIR=""
KIND_BUILD_NAMES=()
KIND_BUILD_PIDS=()
KIND_BUILD_LOGS=()
KIND_BUILD_STARTS=()
KIND_BUILD_WAITED=()

cleanup_kind_builds() {
  local i pid
  for ((i = 0; i < ${#KIND_BUILD_PIDS[@]}; i++)); do
    if [[ "${KIND_BUILD_WAITED[i]}" != "true" ]]; then
      pid="${KIND_BUILD_PIDS[i]}"
      pkill -P "${pid}" 2>/dev/null || true
      kill "${pid}" 2>/dev/null || true
    fi
  done
  if [[ -n "${KIND_BUILD_LOG_DIR}" && -d "${KIND_BUILD_LOG_DIR}" ]]; then
    rm -rf "${KIND_BUILD_LOG_DIR}"
  fi
}

start_kind_build() {
  local name="$1"
  shift
  if [[ -z "${KIND_BUILD_LOG_DIR}" ]]; then
    KIND_BUILD_LOG_DIR="$(mktemp -d)"
    trap cleanup_kind_builds EXIT
  fi
  local log_file="${KIND_BUILD_LOG_DIR}/${name}.log"
  local start_ts
  start_ts="$(date -u +%s)"
  echo "Starting parallel image build: ${name}..."
  (
    "$@"
  ) >"${log_file}" 2>&1 &
  local pid=$!
  KIND_BUILD_NAMES+=("${name}")
  KIND_BUILD_PIDS+=("${pid}")
  KIND_BUILD_LOGS+=("${log_file}")
  KIND_BUILD_STARTS+=("${start_ts}")
  KIND_BUILD_WAITED+=("false")
}

wait_kind_build() {
  local target="$1"
  local idx=-1
  local i
  for ((i = 0; i < ${#KIND_BUILD_NAMES[@]}; i++)); do
    if [[ "${KIND_BUILD_NAMES[i]}" == "${target}" ]]; then
      idx="${i}"
      break
    fi
  done
  if [[ "${idx}" -lt 0 ]]; then
    echo "ERROR: Unknown kind build '${target}'" >&2
    return 1
  fi
  if [[ "${KIND_BUILD_WAITED[idx]}" == "true" ]]; then
    return 0
  fi

  local pid="${KIND_BUILD_PIDS[idx]}"
  local log_file="${KIND_BUILD_LOGS[idx]}"
  local start_ts="${KIND_BUILD_STARTS[idx]}"
  local status=0
  echo "Waiting for parallel image build: ${target}..."
  wait "${pid}" || status=$?
  KIND_BUILD_WAITED[idx]="true"

  local elapsed=$(( $(date -u +%s) - start_ts ))
  if [[ "${status}" -ne 0 ]]; then
    echo "=== ERROR: Parallel image build '${target}' failed (exit ${status}, ${elapsed}s) ===" >&2
    if [[ -f "${log_file}" ]]; then
      cat "${log_file}" >&2
    fi
    return "${status}"
  fi

  echo "=== Parallel image build '${target}' succeeded (${elapsed}s) ==="
  if [[ -f "${log_file}" ]]; then
    cat "${log_file}"
  fi
}

BACKEND_URL="${OBJECTFS_BACKEND:-}"
USE_FAKES3="false"
if [[ -z "${BACKEND_URL}" ]]; then
  USE_FAKES3="true"
  BACKEND_URL="s3://objectfs-bucket?endpoint=http://fakes3.kube-objectfs-system.svc.cluster.local:9000&region=us-east-1&s3ForcePathStyle=true"
fi

SERVICE_PORTALS_DIR="${CACHE_DIR}/service-portals/${SERVICE_PORTALS_COMMIT}"
IN_CLUSTER_STORAGE_DIR="${CACHE_DIR}/in-cluster-storage/${IN_CLUSTER_STORAGE_COMMIT}"

build_service_portals_images() {
  local dir
  dir="$(ensure_cached_repo "service-portals" "https://github.com/gke-labs/service-portals.git" "${SERVICE_PORTALS_COMMIT}")"
  cd "${dir}"
  "${REPO_ROOT}/.build/bin/ap" build \
    images/service-portal-controller \
    images/service-portal-agent \
    images/service-portal-nri-plugin
}

build_in_cluster_storage_images() {
  local dir
  dir="$(ensure_cached_repo "in-cluster-storage" "https://github.com/gke-labs/in-cluster-storage.git" "${IN_CLUSTER_STORAGE_COMMIT}")"
  cd "${dir}"
  local targets=(
    certsigner/images/certsigner
    images/objectfs-controller
    images/objectfs-fuse-holder
    images/objectfs-node-daemon
    images/wal-buffer
  )
  if [[ "${USE_FAKES3}" == "true" ]]; then
    targets+=(fakes3/images/fakes3)
  fi
  "${REPO_ROOT}/.build/bin/ap" build "${targets[@]}"
}

build_ao_images() {
  cd "${REPO_ROOT}"
  "${REPO_ROOT}/.build/bin/ap" build
}

if [[ "${IS_KIND}" == "true" ]]; then
  if has_component "service-portals" || has_component "objectfs" || has_component "ao"; then
    echo "--- Starting parallel image builds for kind ---"
    mkdir -p "${CACHE_DIR}"
    # Pre-warm docker and docker-buildx before launching concurrent ap builds,
    # because ap's lazy tool downloader does not coordinate across processes.
    docker --version >/dev/null
    docker-buildx version >/dev/null
  fi
  if has_component "service-portals"; then
    start_kind_build "service-portals" build_service_portals_images
  fi
  if has_component "objectfs"; then
    start_kind_build "in-cluster-storage" build_in_cluster_storage_images
  fi
  if has_component "ao"; then
    start_kind_build "auto-optimizer" build_ao_images
  fi
fi

# ------------------------------------------------------------------------------
# 1. Namespaces
# ------------------------------------------------------------------------------
echo "--- Ensuring namespaces ao-system and ao-sandboxes exist ---"
kubectl create namespace ao-system --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace ao-sandboxes --dry-run=client -o yaml | kubectl apply -f -

# ------------------------------------------------------------------------------
# 2. agent-sandbox
# ------------------------------------------------------------------------------
if has_component "agent-sandbox"; then
  EXISTING_SERVED="$(kubectl get crd/sandboxes.agents.x-k8s.io -o jsonpath='{.spec.versions[?(@.name=="v1beta1")].served}' 2>/dev/null || true)"
  if [[ "${EXISTING_SERVED}" == "true" && "${FORCE_AGENT_SANDBOX:-0}" != "1" ]]; then
    echo "--- Skipping agent-sandbox: crd/sandboxes.agents.x-k8s.io with v1beta1 served already present (set FORCE_AGENT_SANDBOX=1 to force) ---"
  else
    echo "--- Installing agent-sandbox (${AGENT_SANDBOX_VERSION}) ---"
    kubectl apply --server-side -f "https://github.com/kubernetes-sigs/agent-sandbox/releases/download/${AGENT_SANDBOX_VERSION}/sandbox.yaml"
    kubectl apply --server-side -f "https://github.com/kubernetes-sigs/agent-sandbox/releases/download/${AGENT_SANDBOX_VERSION}/extensions.yaml"

    echo "Waiting for sandboxes.agents.x-k8s.io CRD to be established..."
    kubectl wait --for=condition=Established crd/sandboxes.agents.x-k8s.io --timeout=60s

    echo "Waiting for agent-sandbox-controller deployment in agent-sandbox-system..."
    kubectl rollout status deployment/agent-sandbox-controller -n agent-sandbox-system --timeout=120s
  fi
fi

# ------------------------------------------------------------------------------
# 3. service-portals
# ------------------------------------------------------------------------------
if has_component "service-portals"; then
  if [[ "${IS_KIND}" == "true" ]]; then
    echo "--- Deploying service-portals (${SERVICE_PORTALS_COMMIT}) on kind with ap deploy ---"

    cat << 'EOF' | kubectl apply -f -
apiVersion: v1
kind: Namespace
metadata:
  name: service-portal-system
  labels:
    pod-security.kubernetes.io/enforce: privileged
EOF

    if ! kubectl get secret service-portal-controller-tls -n service-portal-system >/dev/null 2>&1 || \
       ! kubectl get secret service-portal-controller-ca -n service-portal-system >/dev/null 2>&1; then
      echo "Generating throwaway CA and server certificate for service-portal-controller..."
      CERT_TMPDIR="$(mktemp -d)"
      openssl req -x509 -newkey rsa:2048 -nodes \
        -keyout "${CERT_TMPDIR}/ca.key" -out "${CERT_TMPDIR}/ca.crt" -days 365 \
        -subj "/CN=service-portal-ca" 2>/dev/null

      openssl req -newkey rsa:2048 -nodes \
        -keyout "${CERT_TMPDIR}/tls.key" -out "${CERT_TMPDIR}/server.csr" \
        -subj "/CN=service-portal-controller" 2>/dev/null

      cat << 'EOF' > "${CERT_TMPDIR}/extfile.cnf"
subjectAltName = DNS:service-portal-controller,DNS:service-portal-controller.service-portal-system,DNS:service-portal-controller.service-portal-system.svc,DNS:service-portal-controller.service-portal-system.svc.cluster.local,DNS:localhost,IP:127.0.0.1
EOF

      openssl x509 -req -in "${CERT_TMPDIR}/server.csr" \
        -CA "${CERT_TMPDIR}/ca.crt" -CAkey "${CERT_TMPDIR}/ca.key" -CAcreateserial \
        -out "${CERT_TMPDIR}/tls.crt" -days 365 -extfile "${CERT_TMPDIR}/extfile.cnf" 2>/dev/null

      kubectl create secret tls service-portal-controller-tls \
        --cert="${CERT_TMPDIR}/tls.crt" --key="${CERT_TMPDIR}/tls.key" \
        -n service-portal-system --dry-run=client -o yaml | kubectl apply -f -

      kubectl create secret generic service-portal-controller-ca \
        --from-file=tls.crt="${CERT_TMPDIR}/ca.crt" \
        -n service-portal-system --dry-run=client -o yaml | kubectl apply -f -

      rm -rf "${CERT_TMPDIR}"
    fi

    wait_kind_build "service-portals"

    echo "Deploying service-portals manifests with ap deploy..."
    # Do not wait for workloads here; the controller requires the ConfigMap created below by dev/tasks/configure.
    (cd "${SERVICE_PORTALS_DIR}" && "${REPO_ROOT}/.build/bin/ap" deploy --skip-push --wait=false k8s/controller.yaml k8s/node-agent.yaml)

    echo "Configuring service-portals controller with dev/tasks/configure..."
    "${SERVICE_PORTALS_DIR}/dev/tasks/configure" --client-allowlist="system:serviceaccount:ao-system:ao"

    echo "Waiting for service-portal-controller deployment in service-portal-system..."
    kubectl rollout status deployment/service-portal-controller -n service-portal-system --timeout=120s

    echo "Waiting for portal-node-agent daemonset in service-portal-system..."
    kubectl rollout status daemonset/portal-node-agent -n service-portal-system --timeout=120s
  else
    SERVICE_PORTALS_DIR="$(ensure_cached_repo "service-portals" "https://github.com/gke-labs/service-portals.git" "${SERVICE_PORTALS_COMMIT}")"

    if [[ "${INSTALL_SERVICE_PORTALS:-false}" != "true" ]]; then
      echo "--- Skipping service-portals install on non-kind cluster (set INSTALL_SERVICE_PORTALS=true to proceed) ---"
      echo "To deploy service-portals on a non-kind cluster, the operator must provide:"
      echo "  1. containerd with the Node Resource Interface (NRI) enabled on all nodes"
      echo "  2. The TLS Secret 'service-portal-controller-tls' in the 'service-portal-system' namespace"
    else
      echo "--- Installing service-portals on non-kind cluster (explicitly requested) ---"
      if ! kubectl get secret service-portal-controller-tls -n service-portal-system >/dev/null 2>&1; then
        echo "ERROR: secret 'service-portal-controller-tls' not found in namespace 'service-portal-system'" >&2
        exit 1
      fi

      echo "Deploying service-portals manifests with ap deploy..."
      # Do not wait for workloads here; the controller requires the ConfigMap created below by dev/tasks/configure.
      (cd "${SERVICE_PORTALS_DIR}" && "${REPO_ROOT}/.build/bin/ap" deploy --wait=false k8s/controller.yaml k8s/node-agent.yaml)

      echo "Configuring service-portals controller with dev/tasks/configure..."
      "${SERVICE_PORTALS_DIR}/dev/tasks/configure" --client-allowlist="system:serviceaccount:ao-system:ao"

      echo "Waiting for service-portal-controller deployment in service-portal-system..."
      kubectl rollout status deployment/service-portal-controller -n service-portal-system --timeout=120s

      echo "Waiting for portal-node-agent daemonset in service-portal-system..."
      kubectl rollout status daemonset/portal-node-agent -n service-portal-system --timeout=120s
    fi
  fi
fi

# ------------------------------------------------------------------------------
# 4. in-cluster-storage (ObjectFS)
# ------------------------------------------------------------------------------
if has_component "objectfs"; then
  if [[ "${IS_KIND}" != "true" && -z "${OBJECTFS_BACKEND:-}" ]]; then
    echo "--- Skipping objectfs: OBJECTFS_BACKEND is unset on a non-kind cluster ---"
  else
    echo "--- Installing in-cluster-storage / ObjectFS (${IN_CLUSTER_STORAGE_COMMIT}) with ap ---"
    kubectl create namespace kube-objectfs-system --dry-run=client -o yaml | kubectl apply -f -

    if [[ "${IS_KIND}" == "true" ]]; then
      wait_kind_build "in-cluster-storage"

      if [[ "${USE_FAKES3}" == "true" ]]; then
        echo "Loading fakes3 into kind cluster ${KIND_CLUSTER_NAME}..."
        kind load docker-image "${IMAGE_PREFIX}/fakes3:${IMAGE_TAG}" --name "${KIND_CLUSTER_NAME}"

        echo "Deploying in-cluster fakes3 service and deployment..."
        cat << EOF | kubectl apply -f -
apiVersion: v1
kind: Service
metadata:
  name: fakes3
  namespace: kube-objectfs-system
spec:
  ports:
    - port: 9000
      targetPort: 9000
  selector:
    app: fakes3
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fakes3
  namespace: kube-objectfs-system
spec:
  replicas: 1
  selector:
    matchLabels:
      app: fakes3
  template:
    metadata:
      labels:
        app: fakes3
    spec:
      containers:
        - name: fakes3
          image: ${IMAGE_PREFIX}/fakes3:${IMAGE_TAG}
          imagePullPolicy: IfNotPresent
          args: ["--listen=0.0.0.0:9000", "--buckets=objectfs-bucket", "--quiet"]
          ports:
            - containerPort: 9000
EOF
        echo "Waiting for fakes3 deployment..."
        kubectl rollout status deployment/fakes3 -n kube-objectfs-system --timeout=60s
      fi

      echo "Deploying in-cluster-storage manifests with ap deploy..."
      # Do not wait for workloads here; backend config and credentials are configured below before waiting for rollout.
      (cd "${IN_CLUSTER_STORAGE_DIR}" && "${REPO_ROOT}/.build/bin/ap" deploy --skip-push --wait=false)
    else
      IN_CLUSTER_STORAGE_DIR="$(ensure_cached_repo "in-cluster-storage" "https://github.com/gke-labs/in-cluster-storage.git" "${IN_CLUSTER_STORAGE_COMMIT}")"
      echo "Deploying in-cluster-storage with ap deploy (pushing to ${IMAGE_PREFIX})..."
      # Do not wait for workloads here; backend config and credentials are configured below before waiting for rollout.
      (cd "${IN_CLUSTER_STORAGE_DIR}" && "${REPO_ROOT}/.build/bin/ap" deploy --wait=false)
    fi

    # Configure backend via objectfs-config ConfigMap (replaces backend without patching manifests)
    echo "Applying objectfs-config ConfigMap (backend: ${BACKEND_URL})..."
    cat << EOF | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: objectfs-config
  namespace: kube-objectfs-system
data:
  backend: "${BACKEND_URL}"
EOF

    # If using fakes3, create credentials secret and inject into StatefulSets via kubectl set env
    if [[ "${USE_FAKES3}" == "true" ]]; then
      echo "Configuring fakes3 credentials secret..."
      kubectl create secret generic objectfs-s3-credentials \
        -n kube-objectfs-system \
        --from-literal=AWS_ACCESS_KEY_ID=fakes3 \
        --from-literal=AWS_SECRET_ACCESS_KEY=fakes3 \
        --from-literal=AWS_REGION=us-east-1 \
        --dry-run=client -o yaml | kubectl apply -f -

      kubectl set env statefulset/wal-buffer -n kube-objectfs-system --from=secret/objectfs-s3-credentials
      kubectl set env statefulset/objectfs-controller -n kube-objectfs-system --from=secret/objectfs-s3-credentials

      # If pods were started before credentials were set, reset any crashed pod so it restarts immediately
      WAL_READY="$(kubectl get pod wal-buffer-0 -n kube-objectfs-system -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "False")"
      if [[ "${WAL_READY}" != "True" ]]; then
        kubectl delete pod wal-buffer-0 -n kube-objectfs-system --ignore-not-found >/dev/null 2>&1 || true
      fi
      CTRL_READY="$(kubectl get pod objectfs-controller-0 -n kube-objectfs-system -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "False")"
      if [[ "${CTRL_READY}" != "True" ]]; then
        kubectl delete pod objectfs-controller-0 -n kube-objectfs-system --ignore-not-found >/dev/null 2>&1 || true
      fi
    fi

    echo "Waiting for wal-buffer statefulset in kube-objectfs-system..."
    kubectl rollout status statefulset/wal-buffer -n kube-objectfs-system --timeout=120s

    echo "Waiting for objectfs-controller statefulset in kube-objectfs-system..."
    kubectl rollout status statefulset/objectfs-controller -n kube-objectfs-system --timeout=120s

    echo "Waiting for objectfs-fuse-holder daemonset in kube-objectfs-system..."
    kubectl rollout status daemonset/objectfs-fuse-holder -n kube-objectfs-system --timeout=120s

    echo "Waiting for objectfs-node-daemon daemonset in kube-objectfs-system..."
    kubectl rollout status daemonset/objectfs-node-daemon -n kube-objectfs-system --timeout=120s

    echo "Waiting for StorageClass objectfs-exclusive-local to exist..."
    SC_FOUND="false"
    for _ in $(seq 1 30); do
      if kubectl get storageclass objectfs-exclusive-local >/dev/null 2>&1; then
        SC_FOUND="true"
        break
      fi
      sleep 2
    done

    if [[ "${SC_FOUND}" != "true" ]]; then
      echo "ERROR: StorageClass objectfs-exclusive-local was not found after waiting." >&2
      exit 1
    fi
  fi
fi

# ------------------------------------------------------------------------------
# 5. auto-optimizer (ao)
# ------------------------------------------------------------------------------
if has_component "ao"; then
  echo "--- Deploying auto-optimizer with ap ---"
  kubectl create namespace ao-system --dry-run=client -o yaml | kubectl apply -f -
  kubectl create namespace ao-sandboxes --dry-run=client -o yaml | kubectl apply -f -

  if kubectl get secret service-portal-controller-ca -n service-portal-system >/dev/null 2>&1; then
    echo "Copying service-portal-controller-ca Secret into ao-system..."
    CA_CERT="$(kubectl get secret service-portal-controller-ca -n service-portal-system -o jsonpath='{.data.tls\.crt}' | base64 -d)"
    kubectl create secret generic service-portal-controller-ca \
      --from-literal=tls.crt="${CA_CERT}" \
      -n ao-system --dry-run=client -o yaml | kubectl apply -f -
  fi

  SANDBOX_IMAGE="${SANDBOX_IMAGE:-${IMAGE_PREFIX}/geminicli-toolbox:${IMAGE_TAG}}"

  if [[ "${IS_KIND}" == "true" ]]; then
    wait_kind_build "auto-optimizer"
    echo "Loading auto-optimizer sandbox images into kind cluster ${KIND_CLUSTER_NAME}..."
    kind load docker-image \
      "${IMAGE_PREFIX}/geminicli-toolbox:${IMAGE_TAG}" \
      "${IMAGE_PREFIX}/sandbox-go:${IMAGE_TAG}" \
      "${IMAGE_PREFIX}/sandboxd:${IMAGE_TAG}" \
      --name "${KIND_CLUSTER_NAME}"

    echo "Deploying auto-optimizer manifests with ap deploy..."
    # Do not wait for workloads here; ao is patched with --insecure-no-auth and configured below before waiting for rollout.
    (cd "${REPO_ROOT}" && "${REPO_ROOT}/.build/bin/ap" deploy --skip-push --wait=false)

    echo "Configuring ao deployment for kind development (--insecure-no-auth, --workspace-storage-class=objectfs-exclusive-local)..."
    kubectl patch deployment ao -n ao-system --patch '{"spec":{"template":{"spec":{"containers":[{"name":"ao","command":["/ao","serve","--insecure-no-auth","--workspace-storage-class=objectfs-exclusive-local"]}]}}}}'

    OPENAI_MODEL="${OPENAI_MODEL:-fake-eliza}"
    VERTEX_PROJECT="${VERTEX_PROJECT:-}"
    VERTEX_LOCATION="${VERTEX_LOCATION:-}"
    AO_REPOS="${AO_REPOS:-}"
    AO_PUBLIC_URL="${AO_PUBLIC_URL:-}"
    AO_GITHUB_ALLOWED_USERS="${AO_GITHUB_ALLOWED_USERS:-}"
    AO_MAX_TURNS="${AO_MAX_TURNS:-}"
    AO_GIT_AUTHOR="${AO_GIT_AUTHOR:-}"
    PORTAL_CONTROLLER_ADDR="${PORTAL_CONTROLLER_ADDR:-}"
    PORTAL_CONTROLLER_CA_FILE="${PORTAL_CONTROLLER_CA_FILE:-/etc/portal/tls.crt}"
    PORTAL_TOKEN_FILE="${PORTAL_TOKEN_FILE:-/var/run/secrets/portal/token}"
    SANDBOX_EGRESS_HOSTS="${SANDBOX_EGRESS_HOSTS:-}"
    if [[ -z "${PORTAL_CONTROLLER_ADDR}" ]] && kubectl get secret service-portal-controller-ca -n service-portal-system >/dev/null 2>&1; then
      PORTAL_CONTROLLER_ADDR="service-portal-controller.service-portal-system.svc:8443"
    fi

    echo "Configuring ao-config ConfigMap (OPENAI_MODEL=${OPENAI_MODEL}, SANDBOX_IMAGE=${SANDBOX_IMAGE}, SANDBOXD_IMAGE=${SANDBOXD_IMAGE}, VERTEX_PROJECT=${VERTEX_PROJECT}, VERTEX_LOCATION=${VERTEX_LOCATION}, AO_REPOS=${AO_REPOS}, AO_PUBLIC_URL=${AO_PUBLIC_URL}, AO_GITHUB_ALLOWED_USERS=${AO_GITHUB_ALLOWED_USERS}, AO_MAX_TURNS=${AO_MAX_TURNS}, AO_GIT_AUTHOR=${AO_GIT_AUTHOR}, PORTAL_CONTROLLER_ADDR=${PORTAL_CONTROLLER_ADDR}, SANDBOX_EGRESS_HOSTS=${SANDBOX_EGRESS_HOSTS})..."
    cat << EOF | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: ao-config
  namespace: ao-system
data:
  AO_LISTEN: "0.0.0.0:8081"
  AO_HTTP: "0.0.0.0:8080"
  SANDBOX_NAMESPACE: "ao-sandboxes"
  OPENAI_MODEL: "${OPENAI_MODEL}"
  SANDBOX_IMAGE: "${SANDBOX_IMAGE}"
  SANDBOXD_IMAGE: "${SANDBOXD_IMAGE}"
  VERTEX_PROJECT: "${VERTEX_PROJECT}"
  VERTEX_LOCATION: "${VERTEX_LOCATION}"
  AO_REPOS: "${AO_REPOS}"
  AO_PUBLIC_URL: "${AO_PUBLIC_URL}"
  AO_GITHUB_ALLOWED_USERS: "${AO_GITHUB_ALLOWED_USERS}"
  AO_MAX_TURNS: "${AO_MAX_TURNS}"
  AO_GIT_AUTHOR: "${AO_GIT_AUTHOR}"
  PORTAL_CONTROLLER_ADDR: "${PORTAL_CONTROLLER_ADDR}"
  PORTAL_CONTROLLER_CA_FILE: "${PORTAL_CONTROLLER_CA_FILE}"
  PORTAL_TOKEN_FILE: "${PORTAL_TOKEN_FILE}"
  SANDBOX_EGRESS_HOSTS: "${SANDBOX_EGRESS_HOSTS}"
EOF

    kubectl rollout restart deployment/ao -n ao-system
  else
    echo "Building and pushing auto-optimizer images to ${IMAGE_PREFIX} with ap build --push..."
    (cd "${REPO_ROOT}" && "${REPO_ROOT}/.build/bin/ap" build --push)

    echo "Deploying auto-optimizer with ap deploy (pushing to ${IMAGE_PREFIX})..."
    # Do not wait for workloads here; ao is configured below before waiting for rollout.
    (cd "${REPO_ROOT}" && "${REPO_ROOT}/.build/bin/ap" deploy --wait=false)

    VERTEX_PROJECT="${VERTEX_PROJECT:-}"
    if [[ -z "${VERTEX_PROJECT}" ]] && command -v gcloud >/dev/null 2>&1; then
      VERTEX_PROJECT="$(gcloud config get-value project 2>/dev/null || true)"
      if [[ "${VERTEX_PROJECT}" == "(unset)" ]]; then
        VERTEX_PROJECT=""
      fi
    fi
    VERTEX_LOCATION="${VERTEX_LOCATION:-}"
    AO_REPOS="${AO_REPOS:-}"
    AO_PUBLIC_URL="${AO_PUBLIC_URL:-}"
    AO_GITHUB_ALLOWED_USERS="${AO_GITHUB_ALLOWED_USERS:-}"
    AO_MAX_TURNS="${AO_MAX_TURNS:-}"
    AO_GIT_AUTHOR="${AO_GIT_AUTHOR:-}"
    PORTAL_CONTROLLER_ADDR="${PORTAL_CONTROLLER_ADDR:-}"
    PORTAL_CONTROLLER_CA_FILE="${PORTAL_CONTROLLER_CA_FILE:-/etc/portal/tls.crt}"
    PORTAL_TOKEN_FILE="${PORTAL_TOKEN_FILE:-/var/run/secrets/portal/token}"
    SANDBOX_EGRESS_HOSTS="${SANDBOX_EGRESS_HOSTS:-}"

    if [[ -n "${OPENAI_MODEL:-}" || -n "${SANDBOX_IMAGE:-}" || -n "${VERTEX_PROJECT:-}" || -n "${VERTEX_LOCATION:-}" || -n "${SANDBOXD_IMAGE:-}" || -n "${AO_REPOS:-}" || -n "${AO_PUBLIC_URL:-}" || -n "${AO_GITHUB_ALLOWED_USERS:-}" || -n "${AO_MAX_TURNS:-}" || -n "${AO_GIT_AUTHOR:-}" || -n "${PORTAL_CONTROLLER_ADDR:-}" ]]; then
      echo "Configuring ao-config ConfigMap (OPENAI_MODEL=${OPENAI_MODEL:-}, SANDBOX_IMAGE=${SANDBOX_IMAGE:-}, SANDBOXD_IMAGE=${SANDBOXD_IMAGE:-}, VERTEX_PROJECT=${VERTEX_PROJECT:-}, VERTEX_LOCATION=${VERTEX_LOCATION:-}, AO_REPOS=${AO_REPOS}, AO_PUBLIC_URL=${AO_PUBLIC_URL}, AO_GITHUB_ALLOWED_USERS=${AO_GITHUB_ALLOWED_USERS}, AO_MAX_TURNS=${AO_MAX_TURNS}, AO_GIT_AUTHOR=${AO_GIT_AUTHOR})..."
      cat << EOF | kubectl apply -f -
apiVersion: v1
kind: ConfigMap
metadata:
  name: ao-config
  namespace: ao-system
data:
  AO_LISTEN: "0.0.0.0:8081"
  AO_HTTP: "0.0.0.0:8080"
  SANDBOX_NAMESPACE: "ao-sandboxes"
  OPENAI_MODEL: "${OPENAI_MODEL:-}"
  SANDBOX_IMAGE: "${SANDBOX_IMAGE:-}"
  SANDBOXD_IMAGE: "${SANDBOXD_IMAGE}"
  VERTEX_PROJECT: "${VERTEX_PROJECT:-}"
  VERTEX_LOCATION: "${VERTEX_LOCATION:-}"
  AO_REPOS: "${AO_REPOS}"
  AO_PUBLIC_URL: "${AO_PUBLIC_URL}"
  AO_GITHUB_ALLOWED_USERS: "${AO_GITHUB_ALLOWED_USERS}"
  AO_MAX_TURNS: "${AO_MAX_TURNS}"
  AO_GIT_AUTHOR: "${AO_GIT_AUTHOR}"
  PORTAL_CONTROLLER_ADDR: "${PORTAL_CONTROLLER_ADDR}"
  PORTAL_CONTROLLER_CA_FILE: "${PORTAL_CONTROLLER_CA_FILE}"
  PORTAL_TOKEN_FILE: "${PORTAL_TOKEN_FILE}"
  SANDBOX_EGRESS_HOSTS: "${SANDBOX_EGRESS_HOSTS}"
EOF

      kubectl rollout restart deployment/ao -n ao-system
    fi
  fi

  echo "Waiting for auto-optimizer CRDs to be established..."
  kubectl wait --for=condition=Established \
    crd/heroruns.auto-optimizer.labs.gke.io \
    crd/sessions.auto-optimizer.labs.gke.io \
    crd/sessionmessages.auto-optimizer.labs.gke.io \
    --timeout=60s

  if [[ "${IS_KIND}" != "true" ]] && ! kubectl get secret ao-web-auth -n ao-system >/dev/null 2>&1; then
    echo "WARNING: Secret 'ao-web-auth' was not found in namespace ao-system."
    echo "ao serve requires GitHub OAuth authentication when running without --insecure-no-auth."
    echo "Create the secret with AO_GITHUB_CLIENT_ID, AO_GITHUB_CLIENT_SECRET, and AO_SESSION_KEY."
    echo "See docs/running.md for instructions."
    echo "Skipping rollout status wait because 'ao-web-auth' is missing."
  else
    echo "Waiting for ao deployment in ao-system..."
    kubectl rollout status deployment/ao -n ao-system --timeout=120s
  fi
fi

echo "=== deploy-to-kube completed successfully ==="
